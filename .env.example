# MahallaUsta AI agent sozlamalari (ixtiyoriy)
#
# AI_API_KEY bo'lmasa agent lokal bilim bazasida ishlaydi —
# ya'ni chat baribir ishlaydi, faqat LLM javoblari o'rniga tayyor javoblar beriladi.
#
# OpenAI-mos har qanday provayder ishlaydi: OpenAI, OpenRouter, Groq va h.k.

# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=15000

# OpenRouter misoli:
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
